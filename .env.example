# Parcel Yatra — local environment.
# Copy to `.env`. Never commit a filled-in copy.
#
# Every default below is the SAFE pilot default: payments off, payouts off, mock provider.
# Changing one requires the launch gates in legal/LEGAL_REGULATORY_MATRIX.md §8.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_API_URL=http://127.0.0.1:3000/v1
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Must differ from PUBLIC_WEB_URL.
ADMIN_WEB_URL=http://127.0.0.1:5174

# Database: PGlite (embedded PostgreSQL/WASM) for local development.
PGLITE_PATH=./data/pgdata
# Set DATABASE_URL only when pointing at a real PostgreSQL instance.
# DATABASE_URL=

JWT_ACCESS_SECRET=dev_only_access_secret_change_me_48bytes
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_48bytes
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=2592000
OTP_HMAC_SECRET=dev_only_otp_hmac_secret_change_me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
PHONE_HASH_SECRET=dev_only_phone_hash_secret_change_me
# Seals handover codes so the sender can read them in-app; never stored as plaintext at rest.
OTP_SEAL_SECRET=dev_only_otp_seal_secret_change_me

# Google sign-in is the primary identity path. When this is false a verified email is the verified
# contact channel: no OTP is sent during sign-in, onboarding or session restoration, and phone
# collection stays optional. Flipping it to true re-arms the OTP requirement with no code change.
PHONE_VERIFICATION_REQUIRED=false

# Comma-separated addresses that receive the staff role set at sign-in. Compared lowercased against
# the Google-verified email, server-side only. Leave empty to give out no admin access.
ADMIN_EMAILS=

# Extra browser origins allowed to call this API with credentials, comma separated, exact only.
# A suffix pattern such as https://*.vercel.app is refused by design.
WEB_ORIGINS=

# Payments. Development default is `mock`: no money, no provider, dev-only simulator.
# PAYMENT_PROVIDER=upi_direct collects real money on your own UPI handle (no gateway, no fee);
# it requires PAYMENTS_LIVE=true, a real UPI_VPA and UPI_PAYEE_NAME, and finance confirms each
# receipt from the bank statement in the admin UPI receipts queue.
PAYMENTS_LIVE=false
PAYOUTS_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev_only_webhook_secret_change_me
# Only read when PAYMENT_PROVIDER=upi_direct. Leave the placeholders for mock/sandbox.
UPI_VPA=CHANGE_ME@upi
UPI_PAYEE_NAME=CHANGE_ME
DUAL_APPROVAL_THRESHOLD_PAISE=1100000

# Pilot limits
PILOT_MAX_WEIGHT_KG=5
PILOT_MAX_DIMENSION_CM=45
PILOT_MAX_DECLARED_VALUE_PAISE=500000
PILOT_WINDOW_MAX_DAYS=7
QUOTE_TTL_SECONDS=900
ACCEPT_WINDOW_SECONDS=1800
DISPUTE_WINDOW_HOURS=72
REVIEW_WINDOW_DAYS=7

# SMS. `log` is the zero-cost development path: the code is written to the operator log and the
# dev endpoint can read it back. It is never returned to a client. `two_factor` is the production
# path and needs TWO_FACTOR_API_KEY; `fast2sms` needs FAST2SMS_API_KEY. `twilio` is retained for
# staged rollback only.
SMS_PROVIDER=log
# TWO_FACTOR_API_KEY=
# FAST2SMS_API_KEY=
OTP_KILL_SWITCH=false
OTP_RESEND_COOLDOWN_SECONDS=60

# Uploads. `local` keeps files under UPLOAD_DIR on this machine; `cloudinary` is the production
# path and requires all three CLOUDINARY_* values.
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
FILE_SIGNING_SECRET=dev_only_file_signing_secret_change_me
FILE_URL_TTL_SECONDS=300
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Matching engine (packages/domain/src/matching.ts, formula version match-p1.0).
# Weights must be finite and non-negative and at least one must be positive; a bad value fails at
# boot. Distances are great-circle between city centroids, never road kilometres.
MATCH_MAX_ORIGIN_DETOUR_KM=10
MATCH_ARRIVAL_GRACE_HOURS=2
MATCH_MIN_SCORE=50
MATCH_MAX_RESULTS=10
# MATCH_WEIGHTS=time=30,departure=20,detour=20,reliability=15,capacity=10,preference=5
MATCH_CANDIDATE_SCAN_LIMIT=200

# Road distances (apps/api/src/lib/routing.ts). Server-side only; no key ever reaches a browser.
# While ROUTING_PROVIDER=none no provider is called and every city pair is priced on a clearly
# labelled straight-line estimate. To measure the 56 directed pairs, set ROUTING_PROVIDER=google and
# GOOGLE_MAPS_API_KEY, then run:
#   npm run geo:matrix -w @py/api            measure pairs that have no measured distance
#   npm run geo:matrix -w @py/api -- --all   re-measure every pair not already approved
ROUTING_PROVIDER=none
# GOOGLE_MAPS_API_KEY=
ROUTES_CACHE_TTL_DAYS=30
ROUTING_TIMEOUT_MS=8000
ROUTING_MAX_ELEMENTS_PER_CALL=100
# true = refuse to price a pair whose route edge is not operational (no estimates, no cache-only).
REQUIRE_OPERATIONAL_ROUTE=false
# false = refuse to price when no measured distance exists, instead of using an estimate.
ALLOW_ESTIMATED_DISTANCE=true

# Feature flags. Only car mode may be true at pilot.
FEATURE_MATCHING_ENABLED=true
FEATURE_NEW_BOOKINGS_ENABLED=true
FEATURE_VERIFICATION_SUBMISSIONS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_PAYOUTS_ENABLED=false
FEATURE_APP_READONLY=false
FEATURE_MODE_BIKE=false
FEATURE_MODE_BUS=false
FEATURE_MODE_TRAIN=false
FEATURE_MODE_AIR=false

# Jobs
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=1000

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR_PER_NUMBER=3
RATE_LIMIT_OTP_PER_15MIN_PER_NUMBER=3
RATE_LIMIT_OTP_PER_24H_PER_NUMBER=10
RATE_LIMIT_OTP_PER_15MIN_PER_IP=10
TRUST_PROXY=false

LOG_REQUEST_BODIES=false
FAIL_FAST_ON_PAYMENT_CONFIG=true
REQUIRE_SEPARATE_ADMIN_ORIGIN=true
FORBID_MOCK_IN_PRODUCTION=true

# Development-only endpoints: reveal sandbox OTPs, simulate webhooks, advance a booking.
# Refused in production.
ENABLE_DEV_ENDPOINTS=true
AUTO_SEED=true


# Google OAuth (optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE (apps/mobile) — PUBLIC build-time values only. Never put a secret here:
# EXPO_PUBLIC_* variables are embedded in the shipped bundle.
# Put them in apps/mobile/.env, or export them before `npm run start -w @py/mobile`.
# The API default lives in apps/mobile/app.json; override only to point elsewhere.
# Google sign-in is hidden when these are absent, so the app still runs without them.
# ─────────────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE=https://CHANGE_ME.onrender.com/v1
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
