# Parcel Yatra — PRODUCTION environment template
# Copy to .env on your server or paste into Railway's Variables UI.
# Every value marked CHANGE_ME must be replaced with a real value before deploying.
#
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ─────────────────────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Your Railway-deployed API public URL (set after first deploy)
PUBLIC_API_URL=https://CHANGE_ME.up.railway.app/v1

# Your Vercel / Railway web URL
PUBLIC_WEB_URL=https://CHANGE_ME.vercel.app

# Staff admin URL — MUST differ from PUBLIC_WEB_URL.
# Deploy the web app a second time with VITE_ADMIN=true, or use a separate subdomain.
ADMIN_WEB_URL=https://admin-CHANGE_ME.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — Railway PostgreSQL (free, provisioned in the Railway dashboard)
# Copy the "Postgres Connection URL" from the Railway database service → Connect tab.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@CHANGE_ME.railway.internal:5432/railway
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# Apply migrations automatically on every deploy (safe for Railway's single-instance model)
MIGRATE_ON_BOOT=true

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — generate all with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_96_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_96_hex_chars
OTP_HMAC_SECRET=CHANGE_ME_96_hex_chars
PHONE_HASH_SECRET=CHANGE_ME_96_hex_chars
OTP_SEAL_SECRET=CHANGE_ME_96_hex_chars
FILE_SIGNING_SECRET=CHANGE_ME_96_hex_chars

# ─────────────────────────────────────────────────────────────────────────────
# SMS — 2Factor.in (production, Indian DLT-compliant)
# Sign up at https://2factor.in → get your API key from the dashboard.
# IMPORTANT: complete DLT registration for sender ID and template before production use.
# Without DLT, messages to Indian numbers will be rejected by TRAI regulations.
# Use SMS_PROVIDER=log and relay OTPs manually during the DLT registration period.
# ─────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=two_factor
# Server-side only. Never expose to the frontend or include in logs.
TWO_FACTOR_API_KEY=CHANGE_ME

# Kill switch: set to true to block all OTP sends immediately (e.g. under wallet abuse).
# Requires process restart. Revert to false after the incident.
OTP_KILL_SWITCH=false

# Resend cooldown
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# ROLLBACK PATH — to switch back to Twilio if 2Factor has issues:
#   1. Set SMS_PROVIDER=twilio
#   2. Fill in the Twilio credentials below
#   3. Restart the API process
# No database changes required.
# ─────────────────────────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM=+1XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# FILE STORAGE — Cloudinary (free: 25 GB storage + 25 GB bandwidth/month)
# Sign up at https://cloudinary.com → Dashboard → copy Cloud name, API Key, API Secret.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS — sandbox (safe to launch with; wire real gateway behind GATE-3)
# sandbox_provider passes the safety rail without enabling live money movement.
# ─────────────────────────────────────────────────────────────────────────────
PAYMENTS_LIVE=false
PAYOUTS_ENABLED=false
PAYMENT_PROVIDER=sandbox_provider
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_32_chars_min
PAYMENT_CURRENCY=INR
DUAL_APPROVAL_THRESHOLD_PAISE=1100000

# ─────────────────────────────────────────────────────────────────────────────
# PILOT LIMITS (leave as-is for launch)
# ─────────────────────────────────────────────────────────────────────────────
PILOT_MAX_WEIGHT_KG=5
PILOT_MAX_DIMENSION_CM=45
PILOT_MAX_DECLARED_VALUE_PAISE=500000
PILOT_WINDOW_MAX_DAYS=7
QUOTE_TTL_SECONDS=900
ACCEPT_WINDOW_SECONDS=1800
DISPUTE_WINDOW_HOURS=72
REVIEW_WINDOW_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_MATCHING_ENABLED=true
FEATURE_NEW_BOOKINGS_ENABLED=true
FEATURE_VERIFICATION_SUBMISSIONS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_PAYOUTS_ENABLED=false
FEATURE_APP_READONLY=false
# Only car mode at pilot
FEATURE_MODE_BIKE=false
FEATURE_MODE_BUS=false
FEATURE_MODE_TRAIN=false
FEATURE_MODE_AIR=false

# ─────────────────────────────────────────────────────────────────────────────
# JOBS & RATE LIMITS
# ─────────────────────────────────────────────────────────────────────────────
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=5000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR_PER_NUMBER=3
RATE_LIMIT_OTP_PER_15MIN_PER_NUMBER=3
RATE_LIMIT_OTP_PER_24H_PER_NUMBER=10
RATE_LIMIT_OTP_PER_15MIN_PER_IP=10
TRUST_PROXY=true

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY (do not change these in production)
# ─────────────────────────────────────────────────────────────────────────────
LOG_REQUEST_BODIES=false
FAIL_FAST_ON_PAYMENT_CONFIG=true
REQUIRE_SEPARATE_ADMIN_ORIGIN=true
FORBID_MOCK_IN_PRODUCTION=true
ENABLE_DEV_ENDPOINTS=false
AUTO_SEED=false

# Google OAuth (optional — enable for Sign in with Google)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://parcelyatrafinal.vercel.app/auth/google/callback
