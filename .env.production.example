# Parcel Yatra — PRODUCTION environment template
# Copy to .env on your server or paste into Railway's Variables UI.
# Every value marked CHANGE_ME must be replaced with a real value before deploying.
#
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ─────────────────────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Your Railway-deployed API public URL (set after first deploy)
PUBLIC_API_URL=https://CHANGE_ME.up.railway.app/v1

# Your Vercel / Railway web URL
PUBLIC_WEB_URL=https://CHANGE_ME.vercel.app

# Staff admin URL — MUST differ from PUBLIC_WEB_URL.
# Deploy the web app a second time with VITE_ADMIN=true, or use a separate subdomain.
ADMIN_WEB_URL=https://admin-CHANGE_ME.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — Railway PostgreSQL (free, provisioned in the Railway dashboard)
# Copy the "Postgres Connection URL" from the Railway database service → Connect tab.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@CHANGE_ME.railway.internal:5432/railway
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# Apply migrations automatically on every deploy (safe for Railway's single-instance model)
MIGRATE_ON_BOOT=true

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — generate all with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_96_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_96_hex_chars
OTP_HMAC_SECRET=CHANGE_ME_96_hex_chars
PHONE_HASH_SECRET=CHANGE_ME_96_hex_chars
OTP_SEAL_SECRET=CHANGE_ME_96_hex_chars
FILE_SIGNING_SECRET=CHANGE_ME_96_hex_chars

# ─────────────────────────────────────────────────────────────────────────────
# IDENTITY AND ADMIN ACCESS
# Google sign-in is the primary path. While PHONE_VERIFICATION_REQUIRED=false no OTP is sent during
# sign-in, onboarding or session restoration; the Google-verified email is the verified contact
# channel. Set it to true only when a DLT-registered SMS route exists.
# ─────────────────────────────────────────────────────────────────────────────
PHONE_VERIFICATION_REQUIRED=false
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
# Must match an Authorized redirect URI in the Google console, exactly.
GOOGLE_REDIRECT_URI=https://CHANGE_ME.vercel.app/auth/google/callback
# Additional OAuth client audiences accepted by POST /auth/google/token, besides GOOGLE_CLIENT_ID.
# Android native sign-in returns a token issued to the *web* client id configured as `webClientId`,
# so it needs no entry here. Add an iOS client id only if an iOS build sends tokens to this API.
# Leave empty if only the browser and web app sign in with Google.
GOOGLE_ADDITIONAL_CLIENT_IDS=

# Comma-separated staff addresses. The API compares them lowercased against the email Google
# verified, at sign-in, and writes the roles into user_roles. There is no client-side admin check.
ADMIN_EMAILS=kurmikapil154@gmail.com

# Any other browser origin that may send credentials to this API, comma separated and exact.
# PUBLIC_WEB_URL and ADMIN_WEB_URL are already trusted; this list is only for additions.
WEB_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# SMS — 2Factor.in (production, Indian DLT-compliant)
# Sign up at https://2factor.in → get your API key from the dashboard.
# IMPORTANT: complete DLT registration for sender ID and template before production use.
# Without DLT, messages to Indian numbers will be rejected by TRAI regulations.
# Use SMS_PROVIDER=log and relay OTPs manually during the DLT registration period.
# ─────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=two_factor
# Server-side only. Never expose to the frontend or include in logs.
TWO_FACTOR_API_KEY=CHANGE_ME

# Kill switch: set to true to block all OTP sends immediately (e.g. under wallet abuse).
# Requires process restart. Revert to false after the incident.
OTP_KILL_SWITCH=false

# Resend cooldown
OTP_RESEND_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# ROLLBACK PATH — to switch back to Twilio if 2Factor has issues:
#   1. Set SMS_PROVIDER=twilio
#   2. Fill in the Twilio credentials below
#   3. Restart the API process
# No database changes required.
# ─────────────────────────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM=+1XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# FILE STORAGE — Cloudinary (free: 25 GB storage + 25 GB bandwidth/month)
# Sign up at https://cloudinary.com → Dashboard → copy Cloud name, API Key, API Secret.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Signature algorithm the account validates. Cloudinary's default is sha1; set sha256 only if the
# account's own security setting requires it (a sha256 signature on a default account is refused).
CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS
# Two launch options:
#   sandbox_provider — no money moves; the booking flow can be demonstrated end to end.
#   upi_direct       — real money on your own merchant UPI handle (no gateway, no MDR).
#                      Requires PAYMENTS_LIVE=true, UPI_VPA, UPI_PAYEE_NAME. A finance user
#                      records each receipt from the bank statement in Admin → UPI receipts.
#                      Nothing is marked paid automatically on this rail.
# Anything other than upi_direct is refused when PAYMENTS_LIVE=true.
# ─────────────────────────────────────────────────────────────────────────────
PAYMENTS_LIVE=false
PAYOUTS_ENABLED=false
PAYMENT_PROVIDER=sandbox_provider
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_32_chars_min
PAYMENT_CURRENCY=INR
# Only read when PAYMENT_PROVIDER=upi_direct. Replace both, keep the name shown to payers short.
UPI_VPA=CHANGE_ME@upi
UPI_PAYEE_NAME=CHANGE_ME
DUAL_APPROVAL_THRESHOLD_PAISE=1100000

# ─────────────────────────────────────────────────────────────────────────────
# PILOT LIMITS (leave as-is for launch)
# ─────────────────────────────────────────────────────────────────────────────
PILOT_MAX_WEIGHT_KG=5
PILOT_MAX_DIMENSION_CM=45
PILOT_MAX_DECLARED_VALUE_PAISE=500000
PILOT_WINDOW_MAX_DAYS=7
QUOTE_TTL_SECONDS=900
ACCEPT_WINDOW_SECONDS=1800
DISPUTE_WINDOW_HOURS=72
REVIEW_WINDOW_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# MATCHING (formula match-p2.0 — packages/domain/src/matching.ts)
# Hard eligibility gates run first; a score can never override a failed gate. Remaining capacity,
# deadlines and detour are enforced before ranking. A parcel no longer has to share the trip's
# endpoints: both of its cities must project onto the traveller's road route, in travel order, within
# MATCH_MAX_CORRIDOR_KM of the road and MATCH_MAX_DETOUR_KM of extra driving.
# A malformed MATCH_WEIGHTS value fails at boot. Defaults are commented because they are the defaults.
# ─────────────────────────────────────────────────────────────────────────────
MATCH_MAX_ORIGIN_DETOUR_KM=10
MATCH_ARRIVAL_GRACE_HOURS=2
MATCH_MIN_SCORE=50
MATCH_MAX_RESULTS=10
MATCH_CANDIDATE_SCAN_LIMIT=200
MATCH_MAX_CORRIDOR_KM=8
MATCH_MAX_DETOUR_KM=16
MATCH_MIN_LEG_KM=1
MATCH_REQUIRE_ROUTED_GEOMETRY=false
MATCH_ROUTE_TTL_DAYS=14
MATCH_ROUTE_BACKFILL_BATCH=5
# MATCH_WEIGHTS=time=25,departure=15,detour=15,alignment=15,reliability=15,capacity=10,preference=5

# ─────────────────────────────────────────────────────────────────────────────
# ROAD DISTANCES — Google Routes API (server-side only)
# Set ROUTING_PROVIDER=none to launch without a key: every pair is then priced on a labelled
# straight-line estimate and the API says so in each quote. With `google`, fill the key and run
#   npm run geo:matrix -w @py/api
# once (or from the admin endpoint POST /v1/admin/geo/routes/refresh) to measure the 56 pairs.
# Distances are cached; measurement never happens on a request path.
# ─────────────────────────────────────────────────────────────────────────────
ROUTING_PROVIDER=google
# Fill this, or set ROUTING_PROVIDER=none. The API refuses to boot with the literal placeholder.
GOOGLE_MAPS_API_KEY=CHANGE_ME
ROUTES_CACHE_TTL_DAYS=30
ROUTING_TIMEOUT_MS=8000
ROUTING_MAX_ELEMENTS_PER_CALL=100
# Keep false while the matrix is being filled; flip to true once every launched pair is operational
# and you want the API to refuse estimates outright.
REQUIRE_OPERATIONAL_ROUTE=false
ALLOW_ESTIMATED_DISTANCE=true

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_MATCHING_ENABLED=true
FEATURE_NEW_BOOKINGS_ENABLED=true
FEATURE_VERIFICATION_SUBMISSIONS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_PAYOUTS_ENABLED=false
FEATURE_APP_READONLY=false
# Only car mode at pilot
FEATURE_MODE_BIKE=false
FEATURE_MODE_BUS=false
FEATURE_MODE_TRAIN=false
FEATURE_MODE_AIR=false

# ─────────────────────────────────────────────────────────────────────────────
# JOBS & RATE LIMITS
# ─────────────────────────────────────────────────────────────────────────────
JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=5000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_OTP_PER_HOUR_PER_NUMBER=3
RATE_LIMIT_OTP_PER_15MIN_PER_NUMBER=3
RATE_LIMIT_OTP_PER_24H_PER_NUMBER=10
RATE_LIMIT_OTP_PER_15MIN_PER_IP=10
TRUST_PROXY=true

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY (do not change these in production)
# ─────────────────────────────────────────────────────────────────────────────
LOG_REQUEST_BODIES=false
FAIL_FAST_ON_PAYMENT_CONFIG=true
REQUIRE_SEPARATE_ADMIN_ORIGIN=true
FORBID_MOCK_IN_PRODUCTION=true
ENABLE_DEV_ENDPOINTS=false
AUTO_SEED=false

# Google OAuth (optional — enable for Sign in with Google)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://parcelyatrafinal.vercel.app/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE (apps/mobile) — PUBLIC build-time values only, embedded in the bundle.
# These are not read by the API server. Set them in apps/mobile/.env, your shell,
# or in the EAS build profile when a store build is produced.
# ─────────────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE=https://parcelyatrafinal.onrender.com/v1
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
