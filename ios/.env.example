# Parcel Yatra iPhone PWA — build-time environment.
#
# Copy to `ios/.env.local` for a local build, or set these in the Vercel project's Environment
# Variables. Nothing here is a secret: a web bundle has no secrets in it, because the session lives in
# an HttpOnly cookie the JavaScript cannot read. The Google client ID is public by design and comes from
# `apps/mobile/app.json` → `extra.googleWebClientId`, so the two platforms keep using one identity.

# Which backend this build talks to. Metro inlines EXPO_PUBLIC_* while exporting, so the value is baked
# into `dist/` and cannot be changed later by the hosting platform — rebuild if you change it.
#
#   /v1                       same origin. RECOMMENDED, and the only choice that reliably keeps you
#                             signed in on iPhone Safari: the session cookie is then first-party and
#                             survives Tracking Prevention. Needs the PWA served from the same host as
#                             the API (Cloudflare Pages with a `/v1` function, or a proxy path).
#   https://api.example.com/v1  a separate API host. Works, but iOS Safari may drop the cookie after a
#                             week or on a redirect, and the API must list this origin in WEB_ORIGINS.
EXPO_PUBLIC_API_BASE_URL=/v1

# `node scripts/serve.mjs --api <origin>` forwards /v1 and /socket.io to that API so the browser sees
# one origin. Point it at a locally running API to exercise the real cookie + live-tracking flow:
#   npm run dev -w @py/api        # http://127.0.0.1:3000
PY_PROXY_API=http://127.0.0.1:3000

# Port for scripts/serve.mjs. Any port works for localhost; a phone must reach it over the network.
PORT=8080
