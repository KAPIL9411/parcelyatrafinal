{
  "name": "@py/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js && esbuild src/db/migrate.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/migrate.js",
    "start": "node dist/index.js",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "geo:matrix": "tsx scripts/geo-matrix.ts",
    "test:load": "tsx scripts/load-test-tracking.ts",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@py/domain": "*",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.155.0"
  }
}
