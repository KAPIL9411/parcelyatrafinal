{
  "expo": {
    "name": "Parcel Yatra",
    "slug": "parcel-yatra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parcelyatra",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.parcelyatra.app"
    },
    "android": {
      "package": "in.parcelyatra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#005DFD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005DFD",
          "image": "./assets/brand-wordmark-white.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Parcel Yatra needs access to your photos so you can attach a sealed-parcel photo or an identity document.",
          "cameraPermission": "Parcel Yatra uses the camera to photograph a sealed parcel or an identity document."
        }
      ]
    ],
    "extra": {
      "apiBase": "https://parcelyatrafinal.onrender.com/v1",
      "googleWebClientId": "130100214583-b8jp20gsi8teqgoqk116o6pnlb1tqlnm.apps.googleusercontent.com",
      "googleAndroidClientId": "130100214583-klk76hu3g39912dsp5e1tldobslqp7l7.apps.googleusercontent.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4d16ca7e-ffd5-474f-bbde-34c0739de03c"
      }
    }
  }
}
