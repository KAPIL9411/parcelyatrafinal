# Environment Configuration Example
#
# Copy to `.env` and fill in. NEVER commit a filled-in copy.
# This file documents every variable the application reads. If the app reads a
# variable that is not listed here, that is a bug.
#
# Defaults shown are the SAFE defaults: payments off, payouts off, mock provider.
# Changing any of them requires the launch gates in legal/LEGAL_REGULATORY_MATRIX.md §8.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin of the API, used for absolute links in emails/webhooks
PUBLIC_API_URL=http://127.0.0.1:3000/v1
# Public origin of the web app
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Separate origin for the admin console. MUST NOT equal PUBLIC_WEB_URL.
ADMIN_WEB_URL=http://127.0.0.1:5174

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://parcel_yatra:change_me@127.0.0.1:5432/parcel_yatra
# Application role: no UPDATE/DELETE on payment_ledger, no DDL.
DATABASE_APP_ROLE=parcel_yatra_app
# Migration role: separate credentials, used only by the migration job.
DATABASE_MIGRATION_URL=postgres://parcel_yatra_owner:change_me@127.0.0.1:5432/parcel_yatra
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Object storage (private; presigned uploads only)
# ---------------------------------------------------------------------------

STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET_KYC=parcel-yatra-kyc-dev
STORAGE_BUCKET_PARCEL=parcel-yatra-parcel-dev
STORAGE_BUCKET_DISPUTE=parcel-yatra-dispute-dev
STORAGE_ACCESS_KEY=minio_dev_access
STORAGE_SECRET_KEY=minio_dev_secret_change_me
STORAGE_REGION=ap-south-1
STORAGE_UPLOAD_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_48_random_bytes_base64
JWT_REFRESH_SECRET=replace_with_a_different_48_random_bytes_base64
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=2592000
# Used for OTP hashing (HMAC) — rotate on a schedule, see security/SECURE_DEPLOYMENT_CHECKLIST.md
OTP_HMAC_SECRET=replace_with_32_random_bytes_base64
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Phone hashing for admin search — must be stable across restarts, never guessable
PHONE_HASH_SECRET=replace_with_32_random_bytes_base64

GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# SMS / notifications
# ---------------------------------------------------------------------------

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_OTP=
SMS_DLT_TEMPLATE_BOOKING=
PUSH_PROVIDER=mock
PUSH_API_KEY=
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Payments — SANDBOX ONLY AT PILOT
# ---------------------------------------------------------------------------

# Master switch. Must remain false until GATE-3 is signed in writing.
PAYMENTS_LIVE=false
# Must remain false until payout compliance is confirmed.
PAYOUTS_ENABLED=false
# mock | sandbox_provider   (never a live provider at pilot)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace_with_provider_webhook_secret
PAYMENT_CURRENCY=INR
# Refunds/payouts above this require a second approver
DUAL_APPROVAL_THRESHOLD_PAISE=100000

# ---------------------------------------------------------------------------
# Business rules (pilot limits)
# ---------------------------------------------------------------------------

PILOT_MAX_WEIGHT_KG=5
PILOT_MAX_DIMENSION_CM=45
PILOT_MAX_DECLARED_VALUE_PAISE=500000
PILOT_WINDOW_MAX_DAYS=7
QUOTE_TTL_SECONDS=900
ACCEPT_WINDOW_SECONDS=1800
DISPUTE_WINDOW_HOURS=72
REVIEW_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
# Feature flags — every mutating capability must be flaggable
# ---------------------------------------------------------------------------

FEATURE_MATCHING_ENABLED=true
FEATURE_NEW_BOOKINGS_ENABLED=true
FEATURE_VERIFICATION_SUBMISSIONS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=true
FEATURE_PAYOUTS_ENABLED=true
FEATURE_APP_READONLY=false
# Transport modes. Car only at pilot. These MUST stay false.
FEATURE_MODE_BIKE=false
FEATURE_MODE_BUS=false
FEATURE_MODE_TRAIN=false
FEATURE_MODE_AIR=false

# ---------------------------------------------------------------------------
# Jobs and queues (Postgres-backed at pilot)
# ---------------------------------------------------------------------------

JOBS_ENABLED=true
JOB_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5
JOB_LOCK_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_PER_HOUR_PER_NUMBER=3
RATE_LIMIT_OTP_PER_HOUR_PER_IP=10
RATE_LIMIT_READ_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
# In production this must be false: never trust a client-supplied X-Forwarded-For
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PORT=9464
# Structured logs only; never enable request-body logging (it captures PII)
LOG_REQUEST_BODIES=false

# ---------------------------------------------------------------------------
# Safety rails (do not remove)
# ---------------------------------------------------------------------------

# Fail boot if PAYMENTS_LIVE=true but no provider key is configured.
FAIL_FAST_ON_PAYMENT_CONFIG=true
# Refuse to start if ADMIN_WEB_URL === PUBLIC_WEB_URL.
REQUIRE_SEPARATE_ADMIN_ORIGIN=true
# Refuse to start in NODE_ENV=production with PAYMENT_PROVIDER=mock and PAYMENTS_LIVE=true.
FORBID_MOCK_IN_PRODUCTION=true
